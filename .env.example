# Supabase proje adresi (Supabase > Project Settings > API > Project URL).
VITE_SUPABASE_URL=
# Supabase "anon public" anahtarı (Supabase > Project Settings > API > Project API keys).
# Bu anahtar tarayıcıda görünür; güvenlik Row Level Security politikalarıyla sağlanır.
VITE_SUPABASE_ANON_KEY=

